APP_NAME=Professor Cold Email Backend
ENVIRONMENT=development
LOG_LEVEL=INFO

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_SUMMARY=gpt-4.1-mini
OPENAI_MODEL_EMAIL=gpt-4.1-mini
OPENAI_TEMPERATURE=0.7

HTTP_TIMEOUT_SECONDS=20
MAX_SCRAPED_CHARS=8000

# Default sending provider: smtp or gmail_api
EMAIL_PROVIDER=smtp
GMAIL_FROM_EMAIL=your_email@gmail.com

# SMTP (Gmail App Password flow)
GMAIL_SMTP_USER=your_email@gmail.com
GMAIL_SMTP_APP_PASSWORD=your_gmail_app_password

# Gmail API OAuth2 refresh-token flow
GMAIL_API_CLIENT_ID=your_google_client_id_here
GMAIL_API_CLIENT_SECRET=your_google_client_secret_here
GMAIL_API_REFRESH_TOKEN=your_refresh_token
GMAIL_API_TOKEN_URI=https://oauth2.googleapis.com/token
